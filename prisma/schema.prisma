generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  profiles      Profile[]
  favorites     Favorite[]
  watchProgress WatchProgress[]
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  avatar    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Content {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  synopsis    String
  bannerUrl   String
  posterUrl   String
  trailerUrl  String
  videoUrl    String
  year        Int
  rating      Float
  durationMin Int
  genres      String
  cast        String
  maturity    String
  featured    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  favorites   Favorite[]
  progresses  WatchProgress[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

model WatchProgress {
  id           String   @id @default(cuid())
  userId       String
  contentId    String
  profileId    String?
  positionSec  Int      @default(0)
  completedPct Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}
